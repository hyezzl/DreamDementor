    characterSequence: " !\"%+,./0123456789<=>?_bcegilnorux~\u3131\u3134\u3139\u3145\u3146\u3147\u314F\u3153\u3161\u3163\uAC00\uC9C0\uAE08\uC740
      \uC2DC\uB8E8\uB97C \uB9CC\uB098\uB294\uAC8C \uBA3C\uC800\uC57C\u2026\uC2DC\uB8E8\uB97C
      \uB2E4\uC2DC \uBCF4\uAC8C \uB420 \uC904\uC774\uC57C..\r\n\uC5EC\uAE34 \uB3C4\uB300\uCCB4
      \uBB50 \uD558\uB294 \uACF3 \uC77C\uAE4C?\r\n\uC544\uAE4C \uADF8 \uB140\uC11D\uB3C4
      \uADF8\uB807\uACE0...\r\n\uBB54\uAC00.. \uC774\uC0C1\uD55C \uACF3 \uAC19\uC544...\r\n\uBB54\uAC00
      \uC9C0\uAE08\uC740 \uAC00\uBA74 \uC548 \uB420 \uAC70 \uAC19\uC544..\r\n\uAE84\uB974\uB974\uB974\uB974\uB975...\r\n\uC774\uAC8C...\uBB34\uC2A8
