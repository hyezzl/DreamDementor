  Narration:
  - EventID: E001
    Order: 1
    Text: "<color=red>\u201C\uBABD\uB839\u201D</color>\uC744 \uB9CC\uB0AC\uB2E4."
  - EventID: E001
    Order: 2
    Text: "\uC0B6\uC758 \uC758\uC9C0\uAC00 \uD76C\uBBF8\uD574\uC9C4 \uADF8 \uC21C\uAC04\n\uAFC8\uC18D\uC5D0\uC11C
      \uB140\uC11D\uC744 \uB9C8\uC8FC\uCCE4\uB2E4."
  - EventID: E001
    Order: 3
    Text: "\uB0B4\uAC00 \uAFC8\uC18D\uC5D0\uC11C \uC5EC\uB7EC \uAE30\uC5B5\uB4E4\uC744
      \uB9C8\uC8FC\uD560 \uB54C \n\uB140\uC11D\uC774 \uB0A0 \uC9C0\uCF1C\uBCF4\uACE0
      \uC788\uC5C8\uB2E4."
  - EventID: E001
    Order: 4
    Text: "\uB098\uB294 \uB140\uC11D\uC5D0\uAC8C \uBAB8\uC744 \uBE7C\uC557\uAE30\uC9C0
      \uC54A\uAE30 \uC704\uD574\n\uAFC8\uC744 \uBC97\uC5B4\uB098\uB824\uACE0 \uB178\uB825\uD588\uB2E4."
  - EventID: E001
    Order: 5
    Text: "\uB108\uBB34\uB3C4 \uBB34\uC12D\uACE0 \uD798\uB4E4\uC5C8\uC9C0\uB9CC \n\uC0B4\uACE0
      \uC2F6\uB2E4\uB294 \uB2E4\uC9D0 \uD558\uB098\uB85C \uAFC8\uC744 \uBC97\uC5B4\uB0A0
      \uC218 \uC788\uC5C8\uB2E4."
  - EventID: E001
    Order: 6
    Text: .........
  - EventID: E001
    Order: 7
    Text: "\uBABD\uB839\uC740 \uC0B6\uC758 \uC758\uC9C0\uB97C \uC783\uC740 \uC790\uC758
      \uAFC8\uC18D\uC5D0 \uB098\uD0C0\uB098\n\uBAB8\uC744 \uBE7C\uC557\uB294 \uADC0\uC2E0\uC774\uB2E4."
  - EventID: E001
    Order: 8
    Text: "\uC544\uBB34\uB9AC \uD798\uB4E0 \uC77C\uC774 \uC788\uC5B4\uB3C4\n\uC808\uB300
      \uC0B6\uC744 \uD3EC\uAE30\uD558\uB824 \uD558\uBA74 \uC548\uB41C\uB2E4."
  - EventID: E001
    Order: 9
    Text: "\uADF8\uB807\uC9C0 \uC54A\uC73C\uBA74..\n\uADF8\uB140\uC11D\uC744 \uB2E4\uC2DC
      \uB9CC\uB098\uAC8C \uB420\uC9C0\uB3C4 \uBAA8\uB978\uB2E4.."
  - EventID: E001
    Order: 10
    Text: "\uADF8\uB7EC\uB2C8\u2026 \uC774 \uAE00\uC744 \uC77D\uB294 \uB124\uAC00
      \uD639\uC2DC\uB77C\uB3C4 \n\uADF8 \uC874\uC7AC\uB97C \uB9C8\uC8FC\uD558\uAC8C
      \uB41C\uB2E4\uBA74."
  - EventID: E001
    Order: 11
    Text: "\uBB34\uC2A8 \uC77C\uC774 \uC788\uC5B4\uB3C4 \uC0B6\uC744 \uD3EC\uAE30\uD558\uC9C0
      \uB9C8\uB834."
  - EventID: E001
    Order: 12
    Text: "\uC0B4\uACE0 \uC2F6\uB2E4\uB294 \uB9C8\uC74C\uC744 \uB05D\uAE4C\uC9C0
      \uBD99\uC7A1\uC544\uC57C \uD574."
  - EventID: E001
    Order: 13
    Text: "\uB108\uC758 \uADF8 \uB9C8\uC74C\uC774\n\uB108\uB97C \uAFC8\uC18D\uC5D0\uC11C
      \uB098\uAC08 \uC218 \uC788\uAC8C \uD574\uC904\uAC70\uC57C."
